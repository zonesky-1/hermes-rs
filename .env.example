# API Key for router or LLM provider (OpenAI / 9router / OpenRouter / etc.)
ROUTER_API_KEY=your_api_key_here

# Base URL for OpenAI-compatible API
BASE_URL=http://localhost:11434/v1

# Telegram Bot Token (optional, for --gateway mode)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ALLOW_ALL_USERS=true
TELEGRAM_HOME_CHANNEL=

# Outbound HTTP Proxy (optional, e.g. for Tailscale userspace or SOCKS5)
HTTP_PROXY=
